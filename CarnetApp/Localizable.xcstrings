    "browser.connect.line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the “Save to Carnet” extension, paste this link — or type the address and the code. It works once, for ten minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l’extension « Enregistrer dans Carnet », collez ce lien — ou tapez l’adresse et le code. Il sert une fois, pendant dix minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge diesen Link in der Erweiterung „In Carnet speichern“ ein – oder gib die Adresse und den Code ein. Er gilt einmal, zehn Minuten lang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell’estensione «Salva in Carnet», incolla questo link — o digita l’indirizzo e il codice. Vale una volta, per dieci minuti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la extensión «Guardar en Carnet», pega este enlace — o escribe la dirección y el código. Sirve una vez, durante diez minutos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak deze link in de extensie ‘Opslaan in Carnet’ — of typ het adres en de code. Hij werkt één keer, tien minuten lang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na extensão «Guardar no Carnet», cola esta ligação — ou escreve o endereço e o código. Serve uma vez, durante dez minutos."
          }
        }
      }
    },
    "browser.connect.which": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Chrome, Brave, Edge, Arc and Firefox. Safari needs no code: its extension comes with the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour Chrome, Brave, Edge, Arc et Firefox. Safari n’a pas besoin de code : son extension vient avec l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Chrome, Brave, Edge, Arc und Firefox. Safari braucht keinen Code: Die Erweiterung kommt mit der App."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per Chrome, Brave, Edge, Arc e Firefox. Safari non ha bisogno di codice: la sua estensione arriva con l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Chrome, Brave, Edge, Arc y Firefox. Safari no necesita código: su extensión viene con la app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor Chrome, Brave, Edge, Arc en Firefox. Safari heeft geen code nodig: de extensie zit in de app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Chrome, Brave, Edge, Arc e Firefox. O Safari não precisa de código: a extensão vem com a app."
          }
        }
      }
    },
