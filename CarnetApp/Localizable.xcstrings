        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró nada. Pruebe otras palabras: un título, un autor, un año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien trouvé. Essayez d'autres mots : un titre, un auteur, une année."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun risultato. Provi altre parole: un titolo, un autore, un anno."
