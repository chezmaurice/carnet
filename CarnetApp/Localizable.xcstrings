    "give.sent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An %1$@ gesendet. Du findest ihn auch im Haushalt %2$@, wo ihr gemeinsam weiter darüber sprechen könnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent to %1$@. You will also find it in the %2$@ household, where you can go on talking about it together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado a %1$@. También la encontrarás en el hogar %2$@, donde podéis seguir hablando de ella juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé à %1$@. Vous la retrouvez aussi dans le foyer %2$@, où vous pouvez continuer d'en parler ensemble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviato a %1$@. La ritrovi anche nella casa %2$@, dove potete continuare a parlarne insieme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstuurd naar %1$@. Je vindt het ook in huishouden %2$@, waar jullie er samen verder over kunnen praten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado a %1$@. Também a encontra no lar %2$@, onde podem continuar a falar dela juntos."
          }
        }
      }
    },
