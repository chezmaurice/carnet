    "ai.consent.accuracy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maurice ist eine KI; seine Antworten können ungenau sein. Prüfe, was wichtig ist."
          }
        },
        "en": {
