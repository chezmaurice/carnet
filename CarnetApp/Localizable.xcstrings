    "entry.share.hint.owner": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie lesen diesen Eintrag und fügen ihm ihre Notizen hinzu, jede Person unter ihrem eigenen Namen. Deine Markierungen bleiben deine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They read this entry and add their notes to it, each under their own name. Your highlights stay yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leen esta entrada y le añaden sus notas, cada cual con su nombre. Tus pasajes subrayados siguen siendo tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces personnes lisent cette entrée et y ajoutent leurs notes, chacune sous son nom. Vos passages surlignés restent les vôtres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggono questa voce e vi aggiungono le loro note, ciascuno con il proprio nome. I tuoi passaggi evidenziati restano tuoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zij lezen dit item en voegen er hun notities aan toe, ieder onder de eigen naam. Je gemarkeerde passages blijven van jou."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leem esta entrada e acrescentam-lhe as suas notas, cada um com o seu nome. As suas passagens sublinhadas continuam suas."
          }
        }
      }
    },
