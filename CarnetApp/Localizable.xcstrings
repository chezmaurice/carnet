    "add.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts gefunden. Versuchen Sie andere Wörter: einen Titel, einen Autor, ein Jahr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing found. Try other words: a title, an author, a year."
