    },
    "ai.consent.local": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle, die auf dem Rechner deines Maurice laufen, sind nicht betroffen: Nichts verlässt ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models that run on your Maurice’s own machine are not concerned: nothing leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos que funcionan en la máquina de tu Maurice no están afectados: nada sale de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles qui tournent sur la machine de votre Maurice ne sont pas concernés : rien n’en sort."
