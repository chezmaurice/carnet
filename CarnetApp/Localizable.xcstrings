    "household.forget.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die hier angemeldeten Mitglieder werden abgemeldet, und was das Gerät für sie aufbewahrt, wird gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Members signed in here are signed out, and what this device keeps for them is erased."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros conectados aquí cierran sesión, y lo que el dispositivo guarda para ellos se borra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres connectés ici en sont déconnectés, et ce que l’appareil garde pour eux est effacé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I membri collegati qui vengono disconnessi, e ciò che il dispositivo conserva per loro viene cancellato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De leden die hier zijn aangemeld, worden afgemeld, en wat het apparaat voor hen bewaart, wordt gewist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os membros com sessão iniciada aqui saem, e o que o dispositivo guarda para eles é apagado."
          }
        }
      }
    },
