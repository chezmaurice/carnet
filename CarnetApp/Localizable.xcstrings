    "add.file_added": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Bibliothek hinzugefügt. Es erscheint gleich in Ihrer Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added to the library. It will appear in your list shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadido a la biblioteca. Aparecerá en su lista en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté à la bibliothèque. Il apparaîtra bientôt dans votre liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunto alla biblioteca. Apparirà a breve nel suo elenco."
