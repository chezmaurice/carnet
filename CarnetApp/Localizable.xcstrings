    "delete.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was dieser Haushalt über dich aufbewahrt, wird gelöscht, danach dein Konto, endgültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything this household keeps about you will be erased, then your account, for good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que este hogar guarda de ti se borrará, y después tu cuenta, para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que ce foyer garde de vous va être effacé, puis votre compte, définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che questa casa conserva di te verrà cancellato, poi il tuo account, definitivamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat dit huishouden over je bewaart, wordt gewist, daarna je account, voorgoed."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que esta casa guarda de ti será apagado, e depois a tua conta, para sempre."
          }
        }
      }
    },
