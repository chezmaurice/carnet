    "ai.consent.carnet.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst deine Meinung jederzeit ändern, über dein Bild oben in der Liste: %1$@ → %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your mind at any time, from your picture at the top of the list: %1$@ → %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar de opinión en cualquier momento, desde tu foto en la parte superior de la lista: %1$@ → %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez changer d’avis à tout moment, depuis votre photo en haut de la liste : %1$@ → %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare idea in qualsiasi momento, dalla tua foto in cima all’elenco: %1$@ → %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt altijd van gedachten veranderen, via je foto bovenaan de lijst: %1$@ → %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode mudar de ideias a qualquer momento, a partir da sua fotografia no topo da lista: %1$@ → %2$@."
          }
        }
      }
    },
    "ai.consent.carnet.refused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts gesendet: Du hast nicht zugestimmt, deine Daten an die KI-Anbieter zu senden. Du kannst diese Entscheidung über dein Bild oben in der Liste überprüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was sent: you have not agreed to send your data to the AI providers. You can review this choice from your picture at the top of the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha enviado nada: no has aceptado enviar tus datos a los proveedores de IA. Puedes revisar esta elección desde tu foto en la parte superior de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été envoyé : vous n’avez pas accepté d’envoyer vos données aux fournisseurs d’IA. Vous pouvez revoir ce choix depuis votre photo en haut de la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato inviato nulla: non hai accettato di inviare i tuoi dati ai fornitori di IA. Puoi rivedere questa scelta dalla tua foto in cima all’elenco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets verstuurd: je hebt niet ingestemd met het versturen van je gegevens naar de AI-aanbieders. Je kunt deze keuze herzien via je foto bovenaan de lijst."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi enviado: não aceitou enviar os seus dados para os fornecedores de IA. Pode rever esta escolha a partir da sua fotografia no topo da lista."
          }
        }
      }
    },
    "ai.consent.carnet.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Antwort konnte nicht gespeichert werden. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answer could not be recorded. Check the connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar tu respuesta. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réponse n’a pas pu être enregistrée. Vérifiez la connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile registrare la tua risposta. Controlla la connessione e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je antwoord kon niet worden opgeslagen. Controleer de verbinding en probeer het opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registar a sua resposta. Verifique a ligação e tente novamente."
          }
        }
      }
    },
