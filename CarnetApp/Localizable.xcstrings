    "guest.invite.offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Haushalt antwortet nicht. Prüfe deine Verbindung und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The household isn't answering. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hogar no responde. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foyer ne répond pas. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La casa non risponde. Controlla la connessione e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het huishouden reageert niet. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O lar não responde. Verifique a sua ligação e tente de novo."
          }
        }
      }
    },
    "guest.invite.only_you": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Freund sieht in diesem Haushalt nur dich, und nur du kannst mit ihm teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your friend will see only you in this household, and only you will be able to share with them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu amigo solo te verá a ti en este hogar, y solo tú podrás compartir con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ami verra seulement vous dans ce foyer, et vous seulement pourrez partager avec lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo amico vedrà solo te in questa casa, e solo tu potrai condividere con lui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vriend ziet in dit huishouden alleen jou, en alleen jij kunt met hem delen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu amigo só o verá a si neste lar, e só você poderá partilhar com ele."
          }
        }
      }
    },
