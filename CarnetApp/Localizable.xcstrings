    "pinsetup.weak": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese PIN ist zu leicht zu erraten (eine wiederholte Ziffer, eine Folge, eine häufige PIN): Wählen Sie eine andere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PIN is too easy to guess (a repeated digit, a run, a common PIN): choose another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este PIN es demasiado fácil de adivinar (un dígito repetido, una serie, un PIN común): elige otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce PIN est trop facile à deviner (un chiffre répété, une suite, un PIN courant) : choisissez-en un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo PIN è troppo facile da indovinare (una cifra ripetuta, una sequenza, un PIN comune): scegline un altro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze pincode is te makkelijk te raden (een herhaald cijfer, een reeks, een veelgebruikte pincode): kies een andere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este PIN é demasiado fácil de adivinhar (um dígito repetido, uma sequência, um PIN comum): escolha outro."
          }
        }
      }
    },
