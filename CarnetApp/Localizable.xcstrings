    "ai.consent.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maurice ist eine KI. Um dir zu antworten, schickt der Server deines Maurice, was du ihm anvertraust, an einen KI-Dienst eines anderen Unternehmens:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maurice is an AI. To answer you, your Maurice’s server sends what you give Maurice to an artificial-intelligence service run by another company:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Maurice es una IA. Para responderte, el servidor de tu Maurice envía lo que le confías a un servicio de inteligencia artificial de otra empresa:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maurice est une IA. Pour vous répondre, le serveur de votre Maurice envoie ce que vous lui confiez à un service d’intelligence artificielle tenu par une autre entreprise :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maurice è un’IA. Per risponderti, il server del tuo Maurice invia ciò che gli affidi a un servizio di intelligenza artificiale gestito da un’altra azienda:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maurice is een AI. Om je te antwoorden stuurt de server van je Maurice wat je hem toevertrouwt naar een AI-dienst van een ander bedrijf:"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Maurice é uma IA. Para lhe responder, o servidor do seu Maurice envia o que lhe confia a um serviço de inteligência artificial de outra empresa:"
          }
        }
      }
    },
